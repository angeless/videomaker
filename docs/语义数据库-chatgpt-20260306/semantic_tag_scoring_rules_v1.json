{
  "version": "v1",
  "description": "语义标签融合打分规则参考配置",
  "score_formula": "final_score = clamp(base_score + source_bonus + cooccurrence_bonus + hierarchy_bonus + custom_boost - conflict_penalty - negative_penalty + temporal_smooth, 0, 1)",
  "source_weight": {
    "vision_object": 1.0,
    "vision_scene": 0.95,
    "vision_action": 0.95,
    "ocr": 0.75,
    "asr": 0.72,
    "metadata": 0.45,
    "exif": 0.55,
    "gps": 0.6,
    "rule": 1.05,
    "user_feedback_positive": 1.1,
    "user_feedback_negative": 0.65,
    "custom_rule_hit": 1.15
  },
  "display_threshold": {
    "object": 0.55,
    "scene": 0.58,
    "location": 0.6,
    "action": 0.62,
    "person_role": 0.68,
    "season_weather": 0.62,
    "mood": 0.7,
    "custom_tag": 0.72
  },
  "write_threshold": {
    "object": 0.45,
    "scene": 0.5,
    "location": 0.52,
    "action": 0.55,
    "person_role": 0.6,
    "season_weather": 0.56,
    "mood": 0.62,
    "custom_tag": 0.65
  },
  "hierarchy": {
    "child_to_parent_multiplier_min": 0.18,
    "child_to_parent_multiplier_max": 0.35,
    "parent_to_child_hint_min": 0.03,
    "parent_to_child_hint_max": 0.08
  },
  "temporal_smoothing": {
    "scene_window_sec": [
      3,
      8
    ],
    "object_window_sec": [
      1,
      3
    ],
    "action_window_sec": [
      0.5,
      2
    ],
    "scene_persist_bonus": 0.05,
    "object_decay_if_single_hit": 0.1
  },
  "penalty": {
    "conflict_default": 0.18,
    "negative_default": 0.12,
    "duplicate_alias_merge": true
  },
  "cooccurrence_examples": [
    {
      "if_tags": [
        "沙发",
        "电视",
        "茶几"
      ],
      "then_tag": "客厅",
      "bonus_range": [
        0.1,
        0.18
      ]
    },
    {
      "if_tags": [
        "床",
        "枕头",
        "床头柜"
      ],
      "then_tag": "卧室",
      "bonus_range": [
        0.1,
        0.18
      ]
    },
    {
      "if_tags": [
        "锅",
        "灶台",
        "案板"
      ],
      "then_tag": "厨房",
      "bonus_range": [
        0.12,
        0.2
      ]
    },
    {
      "if_tags": [
        "黑板",
        "课桌",
        "学生"
      ],
      "then_tag": "教室",
      "bonus_range": [
        0.12,
        0.22
      ]
    },
    {
      "if_tags": [
        "雪地",
        "羽绒服",
        "呼气白雾"
      ],
      "then_tag": "冬季",
      "bonus_range": [
        0.15,
        0.25
      ]
    }
  ],
  "conflict_pairs": [
    [
      "白天",
      "夜晚"
    ],
    [
      "室内",
      "户外"
    ],
    [
      "晴天",
      "暴雨"
    ],
    [
      "厨房",
      "卧室"
    ],
    [
      "独处",
      "大型聚会"
    ]
  ],
  "negative_rule_examples": [
    {
      "tag": "婚礼",
      "require_any": [
        "白纱",
        "礼堂",
        "花门",
        "舞台",
        "婚礼誓词"
      ],
      "otherwise_penalty": 0.18
    },
    {
      "tag": "医生",
      "negative_any": [
        "广告海报",
        "角色扮演",
        "摆拍"
      ],
      "penalty": 0.14
    },
    {
      "tag": "下雪",
      "negative_any": [
        "白色滤镜",
        "泡沫特效"
      ],
      "penalty": 0.16
    }
  ],
  "custom_tag_policy": {
    "require_parent_system_tag": true,
    "default_threshold": 0.72,
    "gray_release_enabled": true,
    "auto_expand_default": true,
    "allow_direct_write_to_system_library": false
  },
  "learning_candidate_policy": {
    "candidate_entry_conditions_any_2": [
      "7天内出现次数 >= 20",
      "来自 >= 5 个不同资源",
      "与正式标签共现概率 >= 0.6",
      "用户手工确认次数 >= 3",
      "OCR 与视觉双证据同时命中"
    ],
    "auto_promotion_allowed": false,
    "review_actions": [
      "merge_to_alias",
      "upgrade_to_new_tag",
      "become_rule_trigger",
      "reject_noise"
    ]
  },
  "ranking_policy": {
    "keep_top_n_per_segment": 20,
    "keep_top_n_per_asset": 50,
    "min_gap_to_remove_weaker_conflict": 0.08
  }
}